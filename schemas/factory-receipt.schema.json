{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bmozi/accountable-ai-software-factory-companion/schemas/factory-receipt.schema.json",
  "title": "Accountable Factory Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "id", "workOrderId", "intentVersion",
    "candidateDigest", "authorityUsed", "evidenceRecordIds", "disposition",
    "operation", "release", "recoveryOwner", "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "FactoryReceipt"},
    "id": {"type": "string", "minLength": 1},
    "workOrderId": {"type": "string", "minLength": 1},
    "intentVersion": {"type": "integer", "minimum": 1},
    "candidateDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorityUsed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidenceRecordIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["actorId", "decision", "reason"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1},
        "decision": {"enum": ["approve", "reject", "repair", "exception"]},
        "reason": {"type": "string", "minLength": 1},
        "expiresAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {"enum": ["not-started", "known-succeeded", "known-failed", "indeterminate", "reconciled"]},
        "reconciliationEvidence": {"type": ["string", "null"]}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["actorId", "mode", "exposure", "rollback"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1},
        "mode": {"enum": ["none", "advisory", "canary", "limited", "general"]},
        "exposure": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "recoveryOwner": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
