{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bmozi/accountable-ai-software-factory-companion/schemas/work-order.schema.json",
  "title": "Accountable Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "id", "version", "promise", "beneficiary",
    "owner", "consequenceOwner", "producerId", "criteria", "prohibitions",
    "authority", "budgets", "evidenceFloor", "recovery", "outcome"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "WorkOrder"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "promise": {"type": "string", "minLength": 1},
    "beneficiary": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "consequenceOwner": {"type": "string", "minLength": 1},
    "producerId": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "claim"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "prohibitions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "data", "tools", "writes", "environment", "communication", "delegation"],
      "properties": {
        "mode": {"enum": ["read-only", "advisory", "draft-only", "bounded-write"]},
        "data": {"type": "array", "items": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "string", "minLength": 1},
        "communication": {"type": "array", "items": {"type": "string"}},
        "delegation": {"type": "integer", "minimum": 0}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "repairAttempts", "seconds", "costUnits"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "repairAttempts": {"type": "integer", "minimum": 0},
        "seconds": {"type": "integer", "minimum": 1},
        "costUnits": {"type": "number", "minimum": 0}
      }
    },
    "evidenceFloor": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "lostResponse"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "lostResponse": {"const": "reconcile-before-retry"}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["primaryMeasure", "countermetrics", "windowDays"],
      "properties": {
        "primaryMeasure": {"type": "string", "minLength": 1},
        "countermetrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "windowDays": {"type": "integer", "minimum": 1}
      }
    }
  }
}
